# Podman/Docker image for running a functional_framework-based Pebble test
# suite headlessly, without a macOS host at all. App-agnostic - nothing in
# here depends on any one app; everything app-specific (image tag, SDK
# version, build-time env) is supplied via `--build-arg SDK_VERSION=...` by
# container/build_image.sh, which itself reads from the project's own
# app.conf. See container/README.md for the full "why" behind every design
# choice referenced here and for usage.
#
# Build this via container/build_image.sh, not by hand - it resolves
# SDK_VERSION/IMAGE_TAG from a project's app.conf for you. Entrypoint is
# container/entrypoint.sh, which in turn execs run_sequence.sh - see that
# script's own comments for the host-vs-in-container dispatch this all
# plugs into.
#
# --- Why linux/amd64 (not the host's native arch) ---
# pypkjs (PebbleKit JS execution inside the emulator) depends on stpyv8, a
# V8 binding. stpyv8 publishes prebuilt wheels for macOS (x86_64+arm64),
# Windows, and Linux - but its Linux wheels are manylinux_x86_64 ONLY, no
# aarch64/arm64 Linux wheel exists, and building it from source means
# building V8 itself (not practical for a lightweight image). Confirmed by
# querying PyPI directly. So this image targets linux/amd64 always, even
# on an ARM host - on Apple Silicon with Podman's applehv machine and
# Rosetta enabled (`podman machine inspect` should show "Rosetta": true),
# amd64 containers run via Rosetta binary translation, not slow QEMU
# user-mode emulation, so this has near-native performance despite the
# architecture mismatch. (There is then a SECOND, unrelated layer of
# emulation inside the container - qemu-pebble itself, TCG-emulating the
# watch's Cortex-M33 - but that's true on bare macOS too and isn't
# affected by the container's own architecture.)
#
# --- Why --init is required at `podman run` time (not baked in here) ---
# pebble-tool spawns qemu-pebble and pypkjs as child processes and tracks
# their liveness by PID (e.g. to decide whether `pebble install` should
# reuse a running emulator or launch a fresh one). Without a real init
# process as PID 1 to reap them, a `pebble kill`'d emulator's orphaned
# children become permanent zombies (defunct, but still present in the
# process table) - and a zombie's PID still answers "yes I'm alive" to a
# liveness check, so every subsequent pebble command after the first
# kill+wipe+install cycle starts failing with `[Errno 111] Connection
# refused`. Live-verified: this was 100% reproducible with a bare `sleep
# infinity` entrypoint and 100% fixed by re-running the same container
# with `--init` (podman's built-in lightweight init, catatonit). This is a
# `podman run` flag, not something a Containerfile can set for its
# caller, so container/launch.sh always passes it - don't drop it if you
# invoke this image some other way.
FROM debian:bookworm-slim

ARG SDK_VERSION

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      curl ca-certificates git \
      python3 python3-venv python3-pip \
      nodejs npm \
      procps \
      libpixman-1-0 libsdl2-2.0-0 libasound2 libpulse0 libpng16-16 libglib2.0-0 \
      libfaketime \
      imagemagick \
      xvfb xdotool x11-utils \
    && rm -rf /var/lib/apt/lists/*
# xvfb/xdotool/x11-utils are ONLY used by the opt-in TOUCH instruction (see
# functional_framework/lib/steps.sh run_touch and run_sequence.sh's --touch
# flag) - real touchscreen input only reaches a touch-capable app's touch
# handling at all when qemu-pebble opens a genuine SDL/X11 window (i.e.
# `pebble install` run WITHOUT --vnc) that xdotool's XTest-based clicks can
# target; qemu's own `-vnc` framebuffer (what every other sequence uses) is
# display-only and never delivers touch events to the guest - confirmed
# live against a real touch-dial watchapp by adding a debug log to its
# touch-event handler and observing it never fired for a raw VNC pointer
# click, but did fire (Touchdown/Liftoff at the exact target coordinates)
# for an xdotool click against a real Xvfb-hosted window. A held press
# (mousedown, sleep, mouseup - not a bare click) is required for most touch
# UIs, which commonly treat a too-quick tap-and-release as a cancelled
# gesture. This path is container-only by design - there is no supported
# native equivalent. On a real desktop (macOS or otherwise), delivering a
# correctly-hit-tested click into a specific window requires moving the
# real OS mouse cursor and granting OS-level automation permissions
# (Accessibility, on macOS) - both undesirable to require of a real
# interactive desktop session. Inside a disposable container's own Xvfb,
# nobody is looking at "the cursor" at all, so none of that tradeoff
# applies.

ENV PATH="/root/.local/bin:${PATH}"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# The coredevices/pebble-tool fork, not PyPI's own "pebble-tool" package -
# PyPI's is stale and pulls in an old pypkjs whose OWN stpyv8 dependency
# fails outright (a completely separate, older breakage from the
# aarch64-wheel gap above - confirmed by trying `pip install pebble-tool`
# directly; it fails even on plain linux/amd64 with a `ModuleNotFoundError:
# No module named 'settings'` from stpyv8's legacy setup.py).
RUN uv tool install "git+https://github.com/coredevices/pebble-tool.git"

RUN pebble sdk install "${SDK_VERSION}"

WORKDIR /src
# Build context is THIS directory (container/), not the repo root - see
# build_image.sh - so this COPY works regardless of where in a project's
# tree functional_framework/ itself happens to live.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
