# Per-timer Vibration/Sound toggles (DSTYLE_LONG_EXISTING rows 3/4). Can't
# assert the actual haptic/audio output from a screenshot, so this only
# confirms toggling both off doesn't break the edit menu or the alarm
# screen that follows.
#
# NOTE: unverified against a live emulator at authoring time except the
# alarm screen's Stop button, which is DOWN (confirmed).
IMPORT ../common/wipe_and_prep.seq

APPMSG --string 10000="$(printf 'Quick Timer\0375\0371')"
SLEEP 1

# "+ New timer" sits at row 0 and is where a fresh list's selection
# defaults to - ml_select_long() is a no-op there, so move down first.
# The edit-menu screenshots below don't need a TestSetTimerRemainingDisplay
# override: the edit menu is LONG_EXISTING style (shows s_detail_edit_secs
# directly, never reads through effective_now_for()).
TAP down
LONGPRESS select
APPMSG --int 10033=0 --string 10031="12:00"
SCREENSHOT edit_menu
TAP down
TAP down
TAP down
APPMSG --int 10033=0 --string 10031="12:00"
SCREENSHOT vibration_row_selected
TAP select
APPMSG --int 10033=0 --string 10031="12:00"
SCREENSHOT vibration_toggled_off
TAP down
APPMSG --int 10033=0 --string 10031="12:00"
SCREENSHOT sound_row_selected
TAP select
APPMSG --int 10033=0 --string 10031="12:00"
SCREENSHOT sound_toggled_off
TAP back

APPMSG --int 10020=0 10021=1 10022=5
SLEEP 1
SLEEP 7
# The overtime counter here was previously left unpinned/live (per the
# now-removed comment above), on the mistaken assumption it couldn't be
# frozen like other checkpoints - but this is the exact same 5s-timer,
# SLEEP 1 + SLEEP 7 setup as alarm_overtime_display.seq's own first
# checkpoint, which DOES freeze it via a proven -8±5 override (its own
# comment documents this as live-verified across native and containerized
# runs). Applying that same override here instead of leaving the value
# live/unpinned, which was never actually pixel-reproducible run to run.
# Corrected 2026-10-01.
APPMSG --int 10020=0 10029=-8 10030=5 10033=0 --string 10031="12:00"
SCREENSHOT alarm_still_shows_with_both_disabled
TAP down
SLEEP 1
# Idle/stopped after Stop - tc_reset() puts it back to the full configured
# duration (5s), an exact, time-independent constant, safe to check
# tightly (same as alarm_overtime_display.seq's own "dismissed" checkpoint).
APPMSG --int 10020=0 10029=5 10030=2 10033=0 --string 10031="12:00"
SCREENSHOT dismissed_cleanly
