# Exercises pausing a timer that currently holds an ACCEPTED early-wake
# plan - main.c's abandon_early_wake_if_for() should retire that plan (a
# real, separately-tracked WakeupId) the moment the timer stops being
# TS_RUNNING, via the DACT_PAUSE call site.
#
# Getting into the "accepted early-wake" state is now fully automatic
# (try_auto_early_wake() - no menu, no button press): a timer just needs a
# free early-wake slot available when its wakeup conflicts, which happens
# silently and shows no window at all.
#
# HONEST LIMITATION: this framework has no log or persisted-storage
# assertions (v1, screenshots only - see tests/functional_framework/
# README.md's "What this v1 does not do"). A LEAKED plan's only real
# symptom is a stray, already-armed OS wakeup that fires on its own at
# some future moment (a spurious vibration/relaunch for a timer that's no
# longer even running) - this walkthrough can exercise the pause-while-
# holding-a-plan code path and confirm the app doesn't misbehave visibly
# (no crash, correct PAUSED state shown, no immediate spurious alarm), but
# it CANNOT positively confirm the underlying WakeupId was actually
# cancelled rather than leaked - that needs either a `pebble logs`
# side-by-side human review during the run, or a future LOGCHECK-style
# addition to the framework. Treat this sequence as coverage, not full
# proof.
#
# NOTE: live-verified (2026-09-30) - TestSetTimerRemainingDisplay values
# are measured from a live run, not guessed; re-verify if this file's
# button sequence changes.
IMPORT ../common/wipe_and_prep.seq

# Only Timer A's own exact minute (offset 0) is blocked - plenty of other
# free minutes remain in the 15-candidate search window, so
# try_auto_early_wake() silently finds and adopts an early-wake slot: A
# now holds a real, separately-tracked accepted early-wake WakeupId
# (early_wake_timer_id/_wakeup_id), with no window ever shown.
APPMSG --string 10027="0"
APPMSG --string 10000="$(printf 'Timer A\0371200\0371')"
SLEEP 1
APPMSG --int 10020=0 10021=1 10022=1200
SLEEP 1
APPMSG --int 10020=0 10029=1196 10030=8 10033=0 --string 10031="12:00"
SCREENSHOT a_silently_resolved_running

# The main list's own selection sits on its fresh-list default of
# "+ New timer" (row 0) - nothing above touched it. One DOWN first, or the
# next SELECT opens a brand new timer's duration dial instead of Timer
# A's run-control menu.
TAP down

# Pause it via the run-control menu (short SELECT -> row 0 = Stop, row
# 1 = Pause for a TS_RUNNING timer - see tc_detail_actions).
TAP select
APPMSG --int 10020=0 10029=1186 10030=8 10033=0 --string 10031="12:00"
SCREENSHOT run_control_menu
TAP down
TAP select
SLEEP 1
# PAUSED via a real transition - a paused timer's shown value now
# respects TestSetTimerRemainingDisplay too (see remaining_override_get()
# in main.c), but the exact real remaining still depends on precisely when
# this real Pause press lands, so this uses a generous estimate/tolerance
# like the real-transition checkpoints below, not a tight one. Measured
# from a live run: ~1186s (19:46).
APPMSG --int 10020=0 10029=1186 10030=20 10033=0 --string 10031="12:00"
SCREENSHOT timer_now_paused
# Expect: PAUSED state shown, no crash, no conflict window - pausing
# should have silently retired A's accepted early-wake plan
# (abandon_early_wake_if_for(), wired into DACT_PAUSE).

# Resume it and confirm it runs normally (no crash, no immediate stray
# alarm/vibration from a leaked wakeup that happened to already be close
# to firing).
TAP select
TAP down
TAP select
SLEEP 1
# Back to TS_RUNNING via a real Resume - value measured from a live run
# (read directly off the resulting screenshot), not estimated. Real
# Pause/Resume transitions showed more run-to-run variance than pure
# backdoor checkpoints (a second live run differed by ~15s from the
# first), so this uses a wider tolerance than the backdoor-only ones
# above despite starting from a measured center, not a guess.
APPMSG --int 10020=0 10029=1185 10030=20 10033=0 --string 10031="12:00"
SCREENSHOT resumed_running_normally

# Resuming re-attempts rearm_wakeup() for A; since it's still the only
# running timer and offset 0 is still the only blocked minute, this
# should resolve silently again (a fresh early-wake slot found and
# adopted, no window) - confirming the app reacts sanely to a fresh
# rearm after the pause/resume roundtrip.
APPMSG --int 10020=0 10029=1180 10030=20 10033=0 --string 10031="12:00"
SCREENSHOT final_state_no_conflict_window
