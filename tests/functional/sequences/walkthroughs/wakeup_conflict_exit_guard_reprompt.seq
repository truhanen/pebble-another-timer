# Exercises the exit-guard's re-prompt: a running timer's wakeup is still
# failing but no conflict window is currently showing (it was already
# acknowledged once, via "Ok"); pressing BACK on the main list should
# re-show the conflict window as the 2-row exit-attempt variant - "Don't
# exit" (default) and "Exit anyway" - instead of the plain 1-row "Ok"
# (see open_wakeup_conflict_window()/wc_row_kind() - is_exit_prompt=true
# is only ever set by this exit-guard re-prompt path), and choosing "Exit
# anyway" should actually let the app exit.
#
# NOTE: unverified against a live emulator at authoring time - see the
# same caveat in wakeup_conflict_basic_resolutions.seq.
IMPORT ../common/wipe_and_prep_test_hooks.seq

# Timer A: short (180s) duration + a handful of blocked minutes (0-5).
# wakeup_find_early_slot() only has ~2-3 backward candidates available
# before its own `candidate <= time(NULL)` cutoff at this duration, so
# blocking offsets 0-5 (within TEST_BLOCKED_MINUTES_MAX=8) exhausts all of
# them - no free slot exists, and the window shows as the informational
# "Ok" open first. (A long-duration timer has far more than 8 blockable
# candidates and can't be exhausted this way - see the eviction test.)
APPMSG --string 10028="0,1,2,3,4,5"
APPMSG --string 10000="$(printf 'Timer A\037180\0371')"
SLEEP 1
APPMSG --int 10020=0 10021=1 10022=180 10029=1
SLEEP 1

SCREENSHOT conflict_menu_open
# Acknowledge it (the single "Ok" row) - s_last_wakeup_arm_result stays
# WAKEUP_ARM_FAILED afterward (wc_ok() suppresses idle-exit and returns to
# the list, but never resolves the underlying conflict - see wc_ok()), so
# it's still genuinely unresolved.
TAP select
SLEEP 1
SCREENSHOT back_on_main_list_conflict_still_unresolved

# A plain BACK here bypasses close_to_watchface() entirely and would empty
# the window stack by default - exit_guard_appear() is the only thing that
# catches this. Expect the conflict window to reappear (after one deferred
# event-loop tick - see exit_guard_deferred_reopen()), this time as the
# 2-row exit-attempt re-prompt: "Don't exit" (row 0, default) and "Exit
# anyway" (row 1) - no "Ok" row at all in this context.
TAP back
SLEEP 1
SCREENSHOT exit_guard_reprompt_shown

# Select "Exit anyway" (row 1: one DOWN then SELECT) and confirm the app
# actually exits to the watchface instead of re-prompting again or getting
# stuck.
TAP down
TAP select
SLEEP 1
SCREENSHOT after_exit_anyway
