# Pause -> Resume -> Stop from the run-control menu (short SELECT on a
# running row - tc_detail_actions: TS_RUNNING gives Stop=0/Pause=1).
# Confirms Stop restores the FULL configured duration, not whatever
# remaining time was left when stopped.
#
# NOTE: unverified against a live emulator at authoring time.
IMPORT ../common/wipe_and_prep.seq

# AutoReturnStop defaults to on - without disabling it, Stop below would
# auto-exit the whole app to the watchface before we can screenshot the
# stopped list state at all (live-verified: an earlier version of this
# file did exactly that).
APPMSG --int 10018=0

APPMSG --string 10000="$(printf 'Timer A\037300\0371')"
SLEEP 1
APPMSG --int 10020=0 10021=1 10022=300 10029=1
SLEEP 1
SCREENSHOT running_300s

# Unfreeze before the real Pause/Resume/Stop button presses below - each
# of those is a genuine state transition that reads the REAL clock
# (tc_pause()/tc_start()/tc_reset(), deliberately never frozen - see
# display_now()'s own comment on why real logic stays untouched). Leaving
# the display frozen to running_300s's stale seed-moment through those
# would make LATER screenshots show an increasingly large, nonsensical
# remaining value (frozen "now" stuck in the past while end_time keeps
# advancing from fresh real timestamps at each real transition) - worse
# than not freezing at all. The paused/resumed/stopped screenshots below
# keep whatever small amount of real-button-timing jitter they always
# had; FreezeDisplay can't remove that specific kind (it's baked into the
# real stored state at the moment of a real pause, not something drawn).
APPMSG --int 10029=0

# "+ New timer" sits at row 0 and is where a fresh list's selection
# defaults to - a short SELECT there opens a NEW blank timer's duration
# dial, not this timer's run-control menu. One DOWN first.
TAP down
TAP select
SCREENSHOT run_control_menu
TAP down
TAP select
SLEEP 1
SCREENSHOT paused

# Resume: for TS_PAUSED, tc_detail_actions gives Stop=0/Start(Resume)=1.
TAP select
TAP down
TAP select
SLEEP 1
SCREENSHOT resumed_running

# Stop: back to the run-control menu, row 0.
TAP select
SCREENSHOT run_control_menu_again
TAP select
SLEEP 1
SCREENSHOT stopped_should_show_full_duration_not_remaining
