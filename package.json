{
  "name": "pebble-another-timer",
  "author": "Tuukka Ruhanen",
  "version": "1.0.0",
  "keywords": [
    "timer",
    "touch"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Another timer",
    "uuid": "1df6fc5c-261d-49c7-b339-6ea60cbe6649",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "capabilities": [],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "TimerConfig",
      "SortOrder",
      "Request",
      "AutoReturn",
      "RunningFirst",
      "AddTimer",
      "DeleteTimer",
      "UpdateTimerIndex",
      "UpdateTimerSeconds",
      "AddTimerName",
      "UpdateTimerName",
      "IdleExitSec",
      "CfgOpen",
      "LaunchSync",
      "DefaultFinishAction",
      "RunOnCreate"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "menuIcon": true,
          "name": "MENU_ICON",
          "file": "images/menuicon.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_SHIFT_OFF",
          "file": "images/shift-off.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_SHIFT_ONCE",
          "file": "images/shift-once.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_SHIFT_LOCK",
          "file": "images/shift-lock.png"
        }
      ]
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "node --test tests/*.test.js"
  }
}
